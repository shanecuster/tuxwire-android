# Machine-specific: Android Studio writes the SDK location here.
local.properties

# Gradle and IDE output.
build/
.gradle/
.idea/
*.iml
.cxx/
captures/

# Gradle can generate this file; it holds JDK download links, which the F-Droid
# build must not use (see "No JDK download plugin" in the README).
gradle/gradle-daemon-jvm.properties

# Release signing: the keys and the file that points at them never go in git.
keystore.properties
*.jks
*.keystore

# Rust build output.
rust/target/

# Generated by scripts/build-rust.sh -- rebuilt from the Rust source, never
# committed (F-Droid builds from source too).
app/src/main/jniLibs/
app/src/main/kotlin/uniffi/
