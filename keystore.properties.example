# Copy this file to `keystore.properties` in the project root and fill it in.
# `keystore.properties` is git-ignored: never commit it, and never commit the
# keystore (.jks) it points to.

# Full path to the keystore file. Keep it OUTSIDE this project folder and back
# it up: if the key is lost, you cannot publish updates signed with it.
storeFile=/full/path/to/tuxwire-upload.jks

# The key's name inside the keystore (the -alias you gave keytool).
keyAlias=tuxwire-upload

# The passwords. Either write them here, or leave these two lines out and set
# the environment variables TUXWIRE_STORE_PASSWORD and TUXWIRE_KEY_PASSWORD in
# the terminal you build from, so they are never stored in a file.
#storePassword=
#keyPassword=
