<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon, as an "adaptive icon": a background layer and a
  foreground layer that the launcher masks into its own shape. The
  monochrome layer is used for themed icons (Android 13+). minSdk is 26, the
  first Android version with adaptive icons, so no picture files are needed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
