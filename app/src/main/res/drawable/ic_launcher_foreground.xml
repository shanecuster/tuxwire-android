<?xml version="1.0" encoding="utf-8"?>
<!--
  The front layer of the launcher icon: a blue ">" prompt with an orange "_"
  cursor block, redrawn as vector shapes from the author's own 512 x 512
  artwork. The glyph is scaled to 0.2 canvas units per original pixel and
  centred, which keeps every part of it inside the middle 66 x 66 of the
  108 x 108 canvas (the "safe zone"), because launchers crop the edges and
  zoom the icon while it animates.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The ">" of the prompt: one thick stroke with rounded ends and corner. -->
    <path
        android:pathData="M34.8,35.8L55.4,53.9L34.8,72"
        android:strokeColor="#8BADF4"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- The "_" cursor: a rounded orange block. -->
    <path
        android:pathData="M62.4,64.8h14a1.8,1.8 0 0 1 1.8,1.8v6a1.8,1.8 0 0 1 -1.8,1.8h-14a1.8,1.8 0 0 1 -1.8,-1.8v-6a1.8,1.8 0 0 1 1.8,-1.8z"
        android:fillColor="#F5AA7F" />
</vector>
