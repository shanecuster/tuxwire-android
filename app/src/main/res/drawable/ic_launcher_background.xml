<?xml version="1.0" encoding="utf-8"?>
<!--
  The back layer of the launcher icon: a flat dark navy panel. Android crops
  the 108 x 108 canvas to whatever shape the phone's launcher uses (circle,
  squircle, ...). The colour #24283B is sampled from the artwork's own
  background so the foreground blends in seamlessly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#24283B"
        android:pathData="M0,0h108v108h-108z" />
</vector>
