<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: the app's "identity card", read by Android before any of
  our code runs. It declares what the app is called, which screen opens first,
  and which special abilities (permissions) the app asks the user for.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET lets the app download feeds. It is a "normal" permission: Android
      grants it automatically at install time and never shows a prompt.
      This is the ONLY permission tuxwire asks for.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tuxwire"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!--
          allowBackup="false": do not copy the app's private data into Google's
          cloud backups. Saved articles and notes stay on the device unless the
          user turns on sync to their own server (a planned, opt-in feature).
        -->

        <!--
          The one screen. `exported="true"` is required for the screen that the
          launcher starts. The <intent-filter> says "this is the app's main
          entry point and should appear in the app drawer".
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The Share menu entry. This second <intent-filter> says "tuxwire can
              receive plain text that another app shares" (ACTION_SEND with
              text/plain). Browsers share the page's address this way, so
              tuxwire appears in their Share list; choosing it opens the
              add-feed form with the address filled in. The DEFAULT category is
              required for an app to be offered as a Share target. Nothing is
              read except the text the person chose to share.

              launchMode="singleTask" keeps exactly one tuxwire screen: a share
              that arrives while tuxwire is already open is delivered to it
              (MainActivity.onNewIntent) instead of opening a second copy, which
              would open the database twice.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
